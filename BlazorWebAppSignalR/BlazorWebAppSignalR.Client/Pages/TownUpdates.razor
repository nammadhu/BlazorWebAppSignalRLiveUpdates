@page "/town/{TownId:int}"
@using Microsoft.AspNetCore.SignalR.Client
@using Blazored.LocalStorage
@using Shared
@using static Shared.iCardDto
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject IHttpClientFactory _httpClientFactory
@implements IAsyncDisposable

@* @inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization *@

<h3>Real-Time Business Cards for @TownId</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!isConnected)
{
    <p>Connection lost. Attempting to reconnect...</p>
}

<input @bind="newBusinessName" placeholder="Enter business name" />
<input @bind="newContactName" placeholder="Enter contact name" />
<input @bind="newPhoneNumber" placeholder="Enter phone number" />
<input @bind="newEmail" placeholder="Enter email" />
<button @onclick="()=>AddBusinessCard(true)" disabled="@(isConnected == false)">Add Verified Card</button>
<button @onclick="()=>AddBusinessCard(false)" disabled="@(isConnected == false)">Add Draft Card</button>

<h4>Verified Cards</h4>
<ul>
    @foreach (var card in verifiedCards)
    {
        <li>
            @card.BusinessName - @card.ContactName - @card.PhoneNumber - @card.Email
            <button @onclick="() => EditBusinessCard(card, true)" disabled="@(isConnected == false)">Edit</button>
        </li>
    }
</ul>

<h4>Draft Cards</h4>
<ul>
    @foreach (var card in draftCards)
    {
        <li>
            @card.BusinessName - @card.ContactName - @card.PhoneNumber - @card.Email
            <button @onclick="() => EditBusinessCard(card, false)" disabled="@(isConnected == false)">Edit</button>
        </li>
    }
</ul>

@code {
    [Parameter]
    public int TownId { get; set; }
    private List<iCardDto> verifiedCards = new List<iCardDto>();
    private List<iCardDto> draftCards = new List<iCardDto>();
    private HubConnection connection;
    private string newBusinessName;
    private string newContactName;
    private string newPhoneNumber;
    private string newEmail;
    private string editBusinessCardId;
    private bool isConnected = true;
    private bool isLoading = true;
    private DateTime lastSyncedTime = DateTime.MinValue;
    //private bool shouldLoadData = true;
    HttpClient Http;
    // private ClaimsPrincipal user;
    // private string userId;
    // private string userRole;
    protected override void OnInitialized()
    {
        Http = _httpClientFactory.CreateClient("TestAPI");
        base.OnInitialized();
    }
    protected override async Task OnInitializedAsync()
    {
        // var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        // var user = authState.User;
        // isAdmin = user.IsInRole("Admin");
        // if (user.Identity.IsAuthenticated)
        // {
        //     userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        //     userRole = user.FindFirst(ClaimTypes.Role)?.Value;
        // }
        await SignalRConfigure();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || isLoading)
        {
            var storedData = await LocalStorage.GetItemAsync<TownCardsDto>($"businessCards_{TownId}");
            if (storedData != null)
            {
                verifiedCards = storedData.VerifiedCards??[];
                draftCards = storedData.DraftCards??[];
                lastSyncedTime = storedData.LastSyncedTime;

                // Fetch delta updates from API
                await ProcessDeltaUpdates();
            }
            else
            {
                // Fetch initial data from API
                var response = await Http.GetAsync($"api/town/{TownId}");
                if (response.IsSuccessStatusCode)
                {
                    var fullData = await response.Content.ReadFromJsonAsync<TownCardsDto>();
                    if (fullData != null)
                    {
                        verifiedCards = fullData.VerifiedCards??[];
                        draftCards = fullData.DraftCards??[];
                        lastSyncedTime = DateTime.UtcNow;
                        await SaveLocalData();
                    }
                }
            }

            isLoading = false;

            StateHasChanged();
        }
    }
    private async Task SignalRConfigure()
    {
        if (connection == null)
        {
            connection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/townhub"))
                .Build();

            connection.Closed += async (error) =>
            {
                isConnected = false;
                StateHasChanged();

                while (!isConnected)
                {
                    try
                    {
                        await Task.Delay(5000);
                        await connection.StartAsync();
                        await connection.InvokeAsync("JoinGroup", TownId);
                        isConnected = true;

                        // Fetch delta updates from API after reconnecting
                        await ProcessDeltaUpdates();
                    }
                    catch
                    {
                        // Reconnection failed, continue loop
                    }

                    StateHasChanged();
                }
            };

            connection.On<iCardDto, bool>("ReceiveBusinessCard", async (updatedCard, isVerified) =>
            {
                var cardList = isVerified ? verifiedCards : draftCards;
                var index = cardList.FindIndex(bc => bc.Id == updatedCard.Id);
                if (index >= 0)
                {
                    cardList[index] = updatedCard;
                }
                else
                {
                    cardList.Add(updatedCard);
                }
                if (isVerified) verifiedCards = cardList;
                else draftCards = cardList;

                lastSyncedTime = DateTime.UtcNow;
                await SaveLocalData();
                StateHasChanged();
            });

            await connection.StartAsync();
            await connection.InvokeAsync("JoinGroup", TownId);
        }
    }

    public async Task ProcessDeltaUpdates()
    {
        var response = await Http.GetAsync($"api/town/delta/{TownId}/{lastSyncedTime:o}");
        if (response.IsSuccessStatusCode)
        {
            var deltaUpdates = await response.Content.ReadFromJsonAsync<TownCardsDto>();
            if (deltaUpdates != null)
            {
                foreach (var card in deltaUpdates.VerifiedCards)
                {
                    var index = verifiedCards.FindIndex(bc => bc.Id == card.Id);
                    if (index >= 0)
                        verifiedCards[index] = card;
                    else
                        verifiedCards.Add(card);
                }

                foreach (var card in deltaUpdates.DraftCards)
                {
                    var index = draftCards.FindIndex(bc => bc.Id == card.Id);
                    if (index >= 0)
                        draftCards[index] = card;
                    else
                        draftCards.Add(card);
                }
                lastSyncedTime = DateTime.UtcNow;
                await SaveLocalData();
            }
        }
    }

    private async Task AddBusinessCard(bool isVerified)
    {
        if (!string.IsNullOrEmpty(newBusinessName) && !string.IsNullOrEmpty(newContactName))
        {
            var businessCardDto = new iCardDto
                {
                    Id = string.IsNullOrEmpty(editBusinessCardId) ? Guid.NewGuid().ToString() : editBusinessCardId,
                    BusinessName = newBusinessName,
                    ContactName = newContactName,
                    PhoneNumber = newPhoneNumber,
                    Email = newEmail,
                    TownId = TownId,
                    IsVerified = isVerified
                };
            // if (!user.Identity.IsAuthenticated || (isVerified && userRole != "Admin"))
            // {
            //     // Only authenticated users and admins for verified cards
            //     return;
            // }
            if (string.IsNullOrEmpty(editBusinessCardId))
            {
                await connection.InvokeAsync("AddBusinessCard", TownId, businessCardDto, isVerified);
            }
            else
            {
                await connection.InvokeAsync("UpdateBusinessCard", TownId, businessCardDto, isVerified);
                editBusinessCardId = null;
            }

            newBusinessName = string.Empty;
            newContactName = string.Empty;
            newPhoneNumber = string.Empty;
            newEmail = string.Empty;
        }
    }

    private void EditBusinessCard(iCardDto card, bool isVerified)
    {
        newBusinessName = card.BusinessName;
        newContactName = card.ContactName;
        newPhoneNumber = card.PhoneNumber;
        newEmail = card.Email;
        editBusinessCardId = card.Id;
    }

    public async ValueTask DisposeAsync()
    {
        await connection.InvokeAsync("LeaveGroup", TownId);
        await connection.StopAsync();
        await connection.DisposeAsync();
    }

    private async Task SaveLocalData()
    {
        var localData = new TownCardsDto
            {
                VerifiedCards = verifiedCards,
                DraftCards = draftCards,
                LastSyncedTime = lastSyncedTime
            };
        await LocalStorage.SetItemAsync($"businessCards_{TownId}", localData);
    }

}
